#: website/public/get-started/index.html:196
#, python-brace-format
msgctxt "page:get-started/index.html"
msgid "{ph0}Home{ph1} / Get started"
msgstr "{ph0}سەرەکی{ph1} / دەستپێبکە"

#: website/public/get-started/index.html:197
msgctxt "page:get-started/index.html"
msgid "Set up REA."
msgstr "REA دامەزرێنە."

#: website/public/get-started/index.html:198
msgctxt "page:get-started/index.html"
msgid ""
"Connect REA to your coding agent, or inspect a local app from your terminal."
msgstr ""
"REA بە بریکاری کۆدکردنەکەتەوە ببەستە، یان ئەپێکی ناوخۆیی لە تێرمیناڵەکەتەوە "
"بپشکنە."

