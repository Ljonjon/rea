msgstr ""
"Notionـی Markdown دەکاتە داتای بلۆک. ئەم نموونەیە پیشان دەدات چۆن خشتەیەک "
"دەبێتە ڕیزی سەرپەڕە و داتا."

#: website/public/showcase/notion/index.html:522
msgctxt "page:showcase/notion/index.html"
msgid "A table through Notion's Markdown parser"
msgstr "خشتەیەک لە ڕێگەی پارسهری Markdownـی Notionەوە"

#: website/public/showcase/notion/index.html:527
msgctxt "page:showcase/notion/index.html"
msgid "Markdown input"
msgstr "داخڵکردنی Markdown"

#: website/public/showcase/notion/index.html:534
msgctxt "page:showcase/notion/index.html"
