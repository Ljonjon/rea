#, python-brace-format
msgctxt "page:get-started/index.html"
msgid "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Your coding agent"
msgstr "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}بریکاری کۆدکردنەکەت"

#. {ph0}: <span class="prompt-symbol" aria-hidden="true">
#. {ph1}: </span >
#. {ph2}: <span id="agent-install-prompt" >
#. {ph3}: <span translate="no">npx rea-agents@latest setup</span>
#. {ph4}: </span >
#. {ph5}: <span class="terminal-cursor" aria-hidden="true">
#. {ph6}: </span>
#: website/public/get-started/index.html:434
#, python-brace-format
msgctxt "page:get-started/index.html"
msgid ""
"{ph0}›{ph1}{ph2}Install REA and connect it to this coding agent using {ph3}."
" Show me the setup plan for approval, then verify the "
"installation.{ph4}{ph5}{ph6}"
msgstr ""
"{ph0}›{ph1}{ph2}REA دابمەزرێنە و بەم بریکاری کۆدکردنەوە بیبەستە بە "
"بەکارهێنانی {ph3}. پلانی دامەزراندن پیشانم بدە بۆ پەسەندکردن، پاشان "
"دامەزراندنەکە پشتڕاست بکەرەوە.{ph4}{ph5}{ph6}"

#: website/public/get-started/index.html:445
msgctxt "page:get-started/index.html"
msgid "Or run setup yourself"
msgstr "یان خۆت دامەزراندن جێبەجێ بکە"

#: website/public/get-started/index.html:447
msgctxt "page:get-started/index.html"
msgid "How do I open a terminal?"
msgstr "چۆن تێرمیناڵێک دەکەمەوە؟"

#. {ph0}: <strong>
#. {ph1}: </strong>
#. {ph2}: <em>
#. {ph3}: </em>
